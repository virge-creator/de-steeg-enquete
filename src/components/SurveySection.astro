---
import { translations, languages } from '../i18n/translations';
---

<section class="survey">
  {languages.map((lang) => (
    <h2 data-lang={lang} class="survey-title">{translations[lang].surveyTitle}</h2>
  ))}
  <div class="iframe-wrapper">
    <iframe
      id="survey-frame"
      src={translations.nl.surveyUrl}
      data-src={translations.nl.surveyUrl}
      width="100%"
      height={translations.nl.surveyHeight}
      frameborder="0"
      marginheight="0"
      marginwidth="0"
      title="Cannabis usage survey"
    >
      Loading…
    </iframe>
  </div>
</section>

<script>
  import { translations } from '../i18n/translations';

  const iframe = document.getElementById('survey-frame') as HTMLIFrameElement | null;

  function setSurvey(lang: string) {
    if (!iframe) return;
    const t = translations[lang as keyof typeof translations];
    if (!t) return;
    if (iframe.dataset.src !== t.surveyUrl) {
      iframe.src = t.surveyUrl;
      iframe.dataset.src = t.surveyUrl;
    }
    iframe.height = String(t.surveyHeight);
  }

  setSurvey(localStorage.getItem('lang') || 'nl');
  document.addEventListener('langchange', (e) => setSurvey((e as CustomEvent<string>).detail));
</script>

<style>
  .survey {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1rem 3rem;
  }

  .survey-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-border);
  }

  .iframe-wrapper {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  iframe {
    display: block;
    max-width: 100%;
    border: none;
    border-radius: 4px;
  }
</style>
