---
import { translations, languages } from '../i18n/translations';
---

<section class="survey">
  {languages.map((lang) => (
    <h2 data-lang={lang} class="survey-title">{translations[lang].surveyTitle}</h2>
  ))}
  <div class="iframe-wrapper">
    <iframe
      src="https://docs.google.com/forms/d/e/1FAIpQLSdDsHdKqvVRc4o8qNInhW1GNau2Uxv5z0Fe36N7yKoKKlCIVg/viewform?embedded=true"
      width="100%"
      height="3122"
      frameborder="0"
      marginheight="0"
      marginwidth="0"
      title="Cannabis usage survey"
    >
      Loading…
    </iframe>
  </div>
</section>

<style>
  .survey {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 1rem 3rem;
  }

  .survey-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 2px solid var(--color-border);
  }

  .iframe-wrapper {
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  iframe {
    display: block;
    max-width: 100%;
    border: none;
    border-radius: 4px;
  }
</style>
