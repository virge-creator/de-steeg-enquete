---
import { Gift } from '@lucide/astro';
import { translations, languages } from '../i18n/translations';
---

<section class="intro">
  {languages.map((lang) => (
    <div data-lang={lang} class="intro-content">
      <p class="intro-text">{translations[lang].intro}</p>
      <div class="cta">
        <Gift size={20} />
        <p class="cta-text">{translations[lang].cta}</p>
      </div>
    </div>
  ))}
</section>

<style>
  .intro {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1rem 2rem;
  }

  .intro-text {
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .cta {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border-radius: 8px;
    border: 1px solid var(--color-border);
  }

  .cta :global(svg) {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .cta-text {
    font-weight: 600;
    font-size: 1rem;
  }
</style>
